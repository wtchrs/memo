{
  "name": "second-brain",
  "private": true,
  "workspaces": [
    "apps/backend"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:backend": "bun --filter backend dev",
    "db:generate": "bun --filter backend db:generate",
    "db:migrate": "bun --cwd apps/backend db:migrate",
    "db:push": "bun --cwd apps/backend db:push"
  }
}
